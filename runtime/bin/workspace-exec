#!/usr/bin/env bash
set -euo pipefail

STATE_PATH="${STATE_PATH:-/state}"
ROOTFS="$STATE_PATH/rootfs"
WORKSPACE_HOME="${WORKSPACE_HOME:-/home/workspace}"
WORKSPACE_SOURCE="${WORKSPACE_SOURCE:-/mnt/workspace}"
GUEST_CWD="${WORKSPACE_CWD:-$WORKSPACE_HOME}"

[[ -d "$ROOTFS" ]] || { echo "persistent rootfs missing: $ROOTFS" >&2; exit 70; }
[[ -d "$WORKSPACE_SOURCE" ]] || { echo "workspace mount missing: $WORKSPACE_SOURCE" >&2; exit 71; }
[[ -d "$ROOTFS$WORKSPACE_HOME" ]] || { echo "guest home missing: $WORKSPACE_HOME" >&2; exit 72; }

# Preserve deployment-provided environment variables while overriding guest identity/path.
exec env \
  HOME="$WORKSPACE_HOME" \
  USER=root \
  LOGNAME=root \
  SHELL=/bin/zsh \
  TERM="${TERM:-xterm-256color}" \
  BUN_INSTALL=/opt/bun \
  WORKSPACE_PATH="$WORKSPACE_HOME" \
  PATH=/opt/bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  proot --kill-on-exit -0 \
    -r "$ROOTFS" \
    -b "$WORKSPACE_SOURCE:$WORKSPACE_HOME" \
    -b /dev \
    -b /proc \
    -b /sys \
    -b /etc/resolv.conf:/etc/resolv.conf \
    -b /etc/hosts:/etc/hosts \
    -w "$GUEST_CWD" \
    "$@"
