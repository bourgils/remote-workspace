#!/usr/bin/env bash
set -euo pipefail
curl -fsS -u "${OPENCODE_SERVER_USERNAME:-opencode}:${OPENCODE_SERVER_PASSWORD}" \
  "http://127.0.0.1:${OPENCODE_PORT:-4096}/" >/dev/null
curl -fsS -u "${SHELL_USERNAME:-workspace}:${SHELL_PASSWORD}" \
  "http://127.0.0.1:${SHELL_PORT:-7681}/" >/dev/null
[[ -f "${STATE_PATH:-/state}/rootfs/.remote-workspace-initialized" ]]
[[ -d "${WORKSPACE_SOURCE:-/mnt/workspace}" ]]
