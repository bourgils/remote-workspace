#!/usr/bin/env bash
set -euo pipefail

check_http() {
  local name="$1" enabled="$2" username="$3" password="$4" url="$5"
  local -a curl_args=(-fsS)
  case "$enabled" in
    true) curl_args+=(-u "$username:$password") ;;
    false) ;;
    *) echo "$name must be true or false" >&2; exit 64 ;;
  esac
  curl "${curl_args[@]}" "$url" >/dev/null
}

check_http OPENCODE_AUTH_ENABLED "${OPENCODE_AUTH_ENABLED:-true}" \
  "${OPENCODE_SERVER_USERNAME:-opencode}" "${OPENCODE_SERVER_PASSWORD:-}" \
  "http://127.0.0.1:${OPENCODE_PORT:-4096}/"
check_http SHELL_AUTH_ENABLED "${SHELL_AUTH_ENABLED:-true}" \
  "${SHELL_USERNAME:-workspace}" "${SHELL_PASSWORD:-}" \
  "http://127.0.0.1:${SHELL_PORT:-7681}/"
[[ -f "${STATE_PATH:-/state}/rootfs/.remote-workspace-initialized" ]]
[[ -d "${WORKSPACE_SOURCE:-/mnt/workspace}" ]]
