#!/usr/bin/env bash
set -euo pipefail

auth_enabled() {
  case "$2" in
    true) return 0 ;;
    false) return 1 ;;
    *) echo "$1 must be true or false" >&2; exit 64 ;;
  esac
}

if auth_enabled OPENCODE_AUTH_ENABLED "${OPENCODE_AUTH_ENABLED:-true}"; then
  : "${OPENCODE_SERVER_PASSWORD:?OPENCODE_SERVER_PASSWORD is required when OPENCODE_AUTH_ENABLED=true}"
fi
if auth_enabled SHELL_AUTH_ENABLED "${SHELL_AUTH_ENABLED:-true}"; then
  : "${SHELL_PASSWORD:?SHELL_PASSWORD is required when SHELL_AUTH_ENABLED=true}"
fi
/usr/local/bin/workspace-bootstrap

pids=()
cleanup() {
  trap - TERM INT EXIT
  for pid in "${pids[@]:-}"; do kill -TERM "$pid" 2>/dev/null || true; done
  wait 2>/dev/null || true
}
trap cleanup TERM INT EXIT

# One browser tab = one independent ttyd PTY = one independent login shell.
# No tmux/session reuse by design.
ttyd_args=(
  --debug 3
  --port "${SHELL_PORT:-7681}"
  --writable
  --client-option 'theme={"background":"#000000"}'
)
if auth_enabled SHELL_AUTH_ENABLED "${SHELL_AUTH_ENABLED:-true}"; then
  ttyd_args+=(--credential "${SHELL_USERNAME:-workspace}:${SHELL_PASSWORD}")
fi
ttyd "${ttyd_args[@]}" /usr/local/bin/workspace-shell &
pids+=("$!")

/usr/local/bin/workspace-opencode &
pids+=("$!")

# Exit the container if either core service exits.
wait -n "${pids[@]}"
status=$?
echo "[workspace] a core service exited with status $status" >&2
exit "$status"
