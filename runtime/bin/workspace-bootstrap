#!/usr/bin/env bash
set -euo pipefail

STATE_PATH="${STATE_PATH:-/state}"
WORKSPACE_HOME="${WORKSPACE_HOME:-/home/workspace}"
WORKSPACE_SOURCE="${WORKSPACE_SOURCE:-/mnt/workspace}"
ROOTFS="$STATE_PATH/rootfs"
ROOTFS_TEMPLATE=/opt/workspace-rootfs-template
HOME_TEMPLATE=/opt/workspace-home-template
MARKER="$ROOTFS/.remote-workspace-initialized"

case "$WORKSPACE_HOME" in
  /*) ;;
  *) echo "WORKSPACE_HOME must be absolute: $WORKSPACE_HOME" >&2; exit 64 ;;
esac
case "$WORKSPACE_SOURCE" in
  /*) ;;
  *) echo "WORKSPACE_SOURCE must be absolute: $WORKSPACE_SOURCE" >&2; exit 64 ;;
esac

mkdir -p "$STATE_PATH" "$WORKSPACE_SOURCE"

if [[ ! -e "$MARKER" ]]; then
  echo "[workspace] initializing persistent machine rootfs in $ROOTFS"
  mkdir -p "$ROOTFS"
  cp -a "$ROOTFS_TEMPLATE"/. "$ROOTFS"/
  printf '%s\n' "schema=2" "workspace_name=${WORKSPACE_NAME:-workspace}" > "$MARKER"
elif ! grep -qx 'schema=2' "$MARKER"; then
  echo "[workspace] incompatible machine state; create a fresh machine-state volume" >&2
  exit 72
fi

mkdir -p "$ROOTFS$WORKSPACE_HOME"

zshrc="$WORKSPACE_SOURCE/.zshrc"
zshrc_marker="$WORKSPACE_SOURCE/.remote-workspace-zshrc.sha256"
template_zshrc="$HOME_TEMPLATE/.zshrc"
template_hash="$(sha256sum "$template_zshrc" | cut -d ' ' -f 1)"

if [[ ! -e "$zshrc" ]]; then
  echo "[workspace] installing default zsh configuration"
  cp "$template_zshrc" "$zshrc"
  printf '%s\n' "$template_hash" > "$zshrc_marker"
elif [[ -f "$zshrc" && -f "$zshrc_marker" ]]; then
  current_hash="$(sha256sum "$zshrc" | cut -d ' ' -f 1)"
  managed_hash="$(head -n 1 "$zshrc_marker")"
  if [[ "$current_hash" == "$managed_hash" && "$current_hash" != "$template_hash" ]]; then
    echo "[workspace] upgrading default zsh configuration"
    cp "$template_zshrc" "$zshrc"
    printf '%s\n' "$template_hash" > "$zshrc_marker"
  fi
fi

IFS=',' read -ra required_dirs <<< "${WORKSPACE_BOOTSTRAP_DIRS:-}"
for required_dir in "${required_dirs[@]}"; do
  required_dir="${required_dir#"${required_dir%%[![:space:]]*}"}"
  required_dir="${required_dir%"${required_dir##*[![:space:]]}"}"
  case "$required_dir" in
    "") continue ;;
    /*|..|../*|*/..|*/../*)
      echo "invalid WORKSPACE_BOOTSTRAP_DIRS entry: $required_dir" >&2
      exit 64
      ;;
  esac
  mkdir -p "$WORKSPACE_SOURCE/$required_dir"
done

# Host DNS/hosts are bind-mounted at execution time; no host identity is persisted here.
mkdir -p "$ROOTFS/etc"
