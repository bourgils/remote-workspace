#!/usr/bin/env bash
set -euo pipefail

STATE_PATH="${STATE_PATH:-/state}"
ROOTFS="$STATE_PATH/rootfs"
TEMPLATE=/opt/workspace-rootfs-template
MARKER="$ROOTFS/.remote-workspace-initialized"

mkdir -p "$STATE_PATH" "${WORKSPACE_PATH:-/workspace}"

if [[ ! -e "$MARKER" ]]; then
  echo "[workspace] initializing persistent machine rootfs in $ROOTFS"
  mkdir -p "$ROOTFS"
  cp -a "$TEMPLATE"/. "$ROOTFS"/
  printf '%s\n' "schema=1" "workspace_name=${WORKSPACE_NAME:-workspace}" > "$MARKER"
fi

zshrc="$ROOTFS/root/.zshrc"
if [[ -f "$zshrc" ]]; then
  case "$(sha256sum "$zshrc" | cut -d ' ' -f 1)" in
    2330f2d4dd5e89fabfdc547a821fe87ebfc2b08ad82e9330091d4baa7dece12a|a8a88b15f4264967328d2f39375f7a0b4689c3ac9419f0cd490a22b60366209f|60515752b8027df6ef92d9809201d7ad34cfa60a81b39d8b78993beb0c5b1369)
      echo "[workspace] upgrading default zsh configuration"
      cp "$TEMPLATE/root/.zshrc" "$zshrc"
      ;;
  esac
fi

for plugin in zsh-autosuggestions zsh-completions zsh-syntax-highlighting; do
  source_path="$TEMPLATE/root/.oh-my-zsh/custom/plugins/$plugin"
  target_path="$ROOTFS/root/.oh-my-zsh/custom/plugins/$plugin"
  if [[ ! -e "$target_path" ]]; then
    mkdir -p "$(dirname "$target_path")"
    cp -a "$source_path" "$target_path"
  fi
done

# Host DNS/hosts are bind-mounted at execution time; no host identity is persisted here.
mkdir -p "$ROOTFS/etc"
